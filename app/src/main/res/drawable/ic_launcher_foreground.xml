<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — 108×108dp canvas.
  Safe visible zone: centre 72×72dp (18dp inset on every side).
  Design: bold leaf + ECG/heartbeat line = nature meets medicine.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Leaf body — centred, tip at top, rounded base -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,20 C54,20 78,32 78,55 C78,72 67,83 54,87 C41,83 30,72 30,55 C30,32 54,20 54,20Z" />

    <!-- Central leaf vein -->
    <path
        android:strokeColor="#A5D6A7"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M54,26 Q54,57 54,84" />

    <!-- ECG / heartbeat line across the leaf mid-section -->
    <path
        android:strokeColor="#66BB6A"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M33,55 L41,55 L44,44 L49,66 L54,50 L57,60 L62,55 L75,55" />

    <!-- Stem -->
    <path
        android:strokeColor="#C8E6C9"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,85 Q53,92 54,96" />

</vector>
