<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/green_pale">

    <!-- ── TOOLBAR ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/toolbar_gradient_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <!-- Logo row inside Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- App logo + name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/app_logo"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/logo_final"
                        android:contentDescription="@string/cd_app_main_logo"
                        android:background="@drawable/svc_bg_green_shape"
                        android:padding="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name_new"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_tagline"
                            android:textColor="@color/svc_bg_green"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Language + profile icons -->
                <ImageView
                    android:id="@+id/language_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_language"
                    android:background="@drawable/svc_bg_green_shape"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/cd_language_icon" />

                <ImageView
                    android:id="@+id/profile_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_profile"
                    android:background="@drawable/svc_bg_green_shape"
                    android:padding="6dp"
                    android:contentDescription="@string/cd_profile_icon" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Search bar below toolbar row -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_bg"
            app:iconifiedByDefault="false"
            app:queryHint="@string/search_hint"
            app:searchIcon="@null" />
    </LinearLayout>

    <!-- ── SCROLLABLE BODY ───────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HERO CARD ───────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <!-- Avatar -->
                    <ImageView
                        android:id="@+id/heroAvatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_user_details"
                        android:background="@drawable/hero_avatar_bg"
                        android:padding="8dp"
                        android:contentDescription="@string/cd_profile_icon" />

                    <!-- Greeting text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/heroName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name_new"
                            android:textColor="@color/green_dark"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hero_role"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Pending badge -->
                    <LinearLayout
                        android:id="@+id/heroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/welcome_card_bg"
                        android:padding="8dp"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/heroPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/green_primary"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hero_pending_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="7sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── QUICK SERVICES ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_services"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- New User -->
                <LinearLayout
                    android:id="@+id/new_user_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_green_shape">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user_details"
                            android:contentDescription="@string/cd_new_user_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_user"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- New Drug -->
                <LinearLayout
                    android:id="@+id/new_drug_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_purple_shape">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/herbalism"
                            android:contentDescription="@string/cd_new_drug_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_drug"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Check Status -->
                <LinearLayout
                    android:id="@+id/status_icon_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_amber_shape">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_status"
                            android:contentDescription="@string/cd_check_status_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_status"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Drug List -->
                <LinearLayout
                    android:id="@+id/drug_list_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_teal_shape">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/list"
                            android:contentDescription="@string/cd_drug_list_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drug_list"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- List of Plants -->
                <LinearLayout
                    android:id="@+id/list_of_plants_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_pink_shape">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_plants_list"
                            android:contentDescription="@string/cd_plants_list_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_of_plants"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Identify Leaf (accent tile) -->
                <LinearLayout
                    android:id="@+id/identify_leaf_QS"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/tile_accent_bg"
                    android:padding="10dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:background="@drawable/svc_bg_white_alpha">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/herbal_treatment"
                            android:contentDescription="@string/cd_identify_leaf_service" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/identify_leaf"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── EXPLORE CAROUSEL ───────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_explore"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="8dp" />

            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/dots_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                app:dotsColor="@color/green_primary"
                app:selectedDotColor="@color/green_primary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── FOOTER NAV ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/users_list_icon"
                android:layout_width="@dimen/footer_icon_height"
                android:layout_height="@dimen/footer_icon_height"
                android:src="@drawable/ic_users_list"
                android:contentDescription="@string/cd_users_list_footer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/users"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/add_drug_icon"
                android:layout_width="@dimen/footer_icon_height"
                android:layout_height="@dimen/footer_icon_height"
                android:src="@drawable/herbalism"
                android:contentDescription="@string/cd_add_drug_footer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_drug"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="@dimen/footer_icon_height"
                android:layout_height="@dimen/footer_icon_height"
                android:src="@drawable/ic_status"
                android:contentDescription="@string/cd_status_footer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/newsletter_icon"
                android:layout_width="@dimen/footer_icon_height"
                android:layout_height="@dimen/footer_icon_height"
                android:src="@drawable/ic_documents"
                android:contentDescription="@string/cd_newsletter_footer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newsletter"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/transations_icon"
                android:layout_width="@dimen/footer_icon_height"
                android:layout_height="@dimen/footer_icon_height"
                android:src="@drawable/ic_transaction"
                android:contentDescription="@string/cd_transactions_footer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transactions"
                android:textSize="@dimen/text_label"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
