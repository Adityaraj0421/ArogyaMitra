<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/green_pale">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/toolbar_gradient_bg"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- ── STATE: PLANS ──────────────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/layoutPlans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Monthly / Annual toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/welcome_card_bg"
                android:padding="4dp"
                android:layout_marginBottom="16dp">
                <Button
                    android:id="@+id/btnMonthly"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/plan_monthly_price"
                    android:textSize="11sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_secondary" />
                <Button
                    android:id="@+id/btnAnnual"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/plan_annual_price"
                    android:textSize="11sp"
                    android:backgroundTint="@color/green_primary"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Plan card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/corner_card"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Best value chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_best_value"
                        android:background="@drawable/green_chip_bg"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp" />

                    <!-- Price -->
                    <TextView
                        android:id="@+id/tvPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_annual_price"
                        android:textColor="@color/green_dark"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPriceSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_per_month_breakdown"
                        android:textColor="@color/green_light"
                        android:textSize="10sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Features 2-column rows -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_full_database" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_leaf_scan" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_add_medicines" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_validation" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_people" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/feat_priority" android:textSize="10sp" android:drawableStart="@drawable/ic_check_green" android:drawablePadding="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Continue button -->
            <Button
                android:id="@+id/btnContinue"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/plan_continue"
                android:textSize="14sp"
                android:backgroundTint="@color/green_primary" />
        </LinearLayout>
    </ScrollView>

    <!-- ── STATE: PAYMENT ────────────────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/layoutPayment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Payment method tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/tabUpi"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_upi"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/green_primary"
                    android:textColor="@color/white" />
                <Button
                    android:id="@+id/tabCard"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_card"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_secondary" />
                <Button
                    android:id="@+id/tabNetBanking"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/tab_netbanking"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- UPI panel -->
            <LinearLayout
                android:id="@+id/panelUpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_input"
                    app:boxCornerRadiusBottomStart="@dimen/corner_input"
                    app:boxCornerRadiusTopEnd="@dimen/corner_input"
                    app:boxCornerRadiusTopStart="@dimen/corner_input">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUpiId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/upi_hint"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quick UPI apps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btnGpay" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GPay" android:textSize="10sp" android:layout_marginEnd="4dp" />
                    <Button android:id="@+id/btnPhonepe" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PhonePe" android:textSize="10sp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
                    <Button android:id="@+id/btnPaytm" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Paytm" android:textSize="10sp" android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card panel -->
            <LinearLayout
                android:id="@+id/panelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/card_number_hint"
                        android:inputType="number"
                        android:maxLength="19" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/card_expiry_hint"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/card_cvv_hint"
                            android:inputType="numberPassword"
                            android:maxLength="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/card_name_hint"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Net Banking panel -->
            <LinearLayout
                android:id="@+id/panelNetBanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/spinnerBank"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Pay button -->
            <Button
                android:id="@+id/btnPay"
                style="?attr/materialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/pay_annual"
                android:textSize="14sp"
                android:backgroundTint="@color/green_primary" />

            <ProgressBar
                android:id="@+id/progressPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 256-bit SSL · Secured"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ── STATE: SUCCESS ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/toolbar_gradient_bg"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivSuccessCheck"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_check_circle_white"
            android:contentDescription="@string/payment_success_title"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_success_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSuccessSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_success_sub"
            android:textColor="@color/svc_bg_green"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvTxnId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/svc_bg_green"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvValidUntil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/svc_bg_green"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnStartPro"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/start_pro"
            android:backgroundTint="@color/white"
            android:textColor="@color/green_primary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
